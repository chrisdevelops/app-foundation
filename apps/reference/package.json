    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@foundation/foundation": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.3.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
