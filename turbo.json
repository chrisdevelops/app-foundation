{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.ts"],
  "tasks": {
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "//#typecheck": {
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "//#test": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/**",
        "apps/**",
        "!**/node_modules/**",
        "!apps/*/.vite/**",
        "!apps/*/out/**",
        "!**/.turbo/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "@foundation/e2e#test": {
      "dependsOn": ["//#test"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/tools/test-support/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/apps/*/.vite/**",
        "!$TURBO_ROOT$/apps/*/out/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/*.tsbuildinfo"
      ]
    }
  }
}
