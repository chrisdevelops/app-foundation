{
  "color": {
    "ui-color-bg-default": {
      "$type": "color",
      "$value": "{ref.color.ui-ref-color-gray-50}",
      "$description": "Default surface background.",
      "$extensions": {
        "io.github.chrisdevelops.ui": {
          "usage": "Window and panel backgrounds."
        }
      }
    },
    "ui-color-fg-default": {
      "$type": "color",
      "$value": "{ref.color.ui-ref-color-gray-900}",
      "$description": "Body text on default surfaces.",
      "$extensions": {
        "io.github.chrisdevelops.ui": {
          "usage": "Paragraphs, labels and table cells.",
          "contrastWith": ["ui-color-bg-default"]
        }
      }
    },
    "ui-color-bg-accent-default": {
      "$type": "color",
      "$value": "{ref.color.ui-ref-color-brand-600}",
      "$description": "Background for the primary action.",
      "$extensions": {
        "io.github.chrisdevelops.ui": {
          "usage": "Primary buttons and selected items."
        }
      }
    }
  }
}
